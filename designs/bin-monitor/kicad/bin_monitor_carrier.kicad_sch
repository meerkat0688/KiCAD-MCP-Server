	)
	(text "J1: 1=3V3  2=GND  3=SDA  4=SCL\nRemote module: Pololu 3415 / VL53L1X. Wire by silkscreen names.\nDo NOT connect a bare 2.8V sensor. No extra I2C pullups on this board."
		(exclude_from_sim no)
		(at 45.72 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5963c14d-9ff7-4e62-a7f7-e5ac73a6539d")
	)
	(text "5V enters ONLY via XIAO USB-C. No battery; VBUS header unused.\nD4=GPIO6 SDA; D5=GPIO7 SCL. 3V3 comes from module regulator.\nGPIO4 drives R1 + D1; threshold firmware and LINE are not implemented here."
		(exclude_from_sim no)
		(at 45.72 185.42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d09d43d4-f26b-42bf-89fd-7056caad46c2")
	)
	(text "DRAFT REVIEW ONLY - NOT FOR FABRICATION\nSensor range, power, header fit, mounting and cost remain unverified.\nUser bin: 130cm high x70cm wide, no lid. Hardware target <USD50."
		(exclude_from_sim no)
		(at 193.04 111.76 0)
		(effects
